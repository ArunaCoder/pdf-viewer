{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Violeta PDF",
  "version": "0.1.0",
  "identifier": "com.violeta.pdfviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Violeta PDF",
        "width": 1360,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "Documento PDF",
        "description": "Documento PDF",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ]
  }
}
